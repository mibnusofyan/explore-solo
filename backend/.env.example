# Salin menjadi backend/.env lalu sesuaikan.
NODE_ENV=development
PORT=4000
# Alamat frontend (dipakai untuk CORS, tautan email, dan callback Midtrans).
APP_URL=http://localhost:5173
# Wajib diganti dengan string acak panjang di produksi.
SESSION_SECRET=ganti-dengan-string-acak-panjang

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=explore_solo
DB_PASSWORD=explore_solo_dev
DB_NAME=explore_solo

# Midtrans (sandbox: https://dashboard.sandbox.midtrans.com → Settings → Access Keys).
# Kosongkan untuk memakai simulasi pembayaran saat pengembangan.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
# Notification URL di dashboard Midtrans: https://<domain-anda>/api/payments/midtrans/notification

# SMTP untuk email verifikasi dan e-tiket. Kosongkan untuk mencetak email ke konsol.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Explore Solo <no-reply@exploresolo.id>"
